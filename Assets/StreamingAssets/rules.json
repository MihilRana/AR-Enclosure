      "door_state": "any",
      "obstacle": "wall",
      "applies_if": { "gangway_length_gt_m": 10 },
      "level": "advisory",
      "note": "One accepted way to make a gangway longer than 10 m reachable from both ends. Informative note, so warn only."
    },
