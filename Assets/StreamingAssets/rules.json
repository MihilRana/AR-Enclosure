      "id": "front_gangway",
      "label": "Front gangway",
      "face": "front",
      "min_m": 0.700,
      "source": "IEC 60364-7-729, clause 729.513.2.1 b)",
      "value_source": "standard",
      "configurable": false,
      "reference": "enclosure_face",
      "door_state": "closed",
      "obstacle": "any",
      "applies_if": {},
      "level": "required",
      "note": "Gap from the enclosure front to a wall or to another enclosure across the gangway."
    },
    {
      "id": "front_handle_clearance",
      "label": "Handle clearance",
      "face": "front",
      "min_m": 0.600,
      "source": "IEC 60364-7-729, clause 729.513.2.1 a)",
      "value_source": "standard",
      "configurable": false,
      "reference": "handle_or_isolated_breaker",
      "door_state": "closed",
      "obstacle": "any",
      "applies_if": {},
      "level": "required",
      "note": "Gap from the front of switch handles, or a breaker in isolation position, to the wall or to the opposite handles."
    },
    {
      "id": "door_swing_90",
      "label": "Door swing",
      "face": "front",
      "min_m": null,
      "source": "IEC 60364-7-729, clause 729.513.2 and Annex A, clause A.1",
      "value_source": "model_door_geometry",
      "configurable": false,
      "reference": "enclosure_face",
      "door_state": "open_90",
      "obstacle": "any",
      "applies_if": {},
      "level": "required",
      "note": "Doors must open to at least 90 degrees. Required gap = widest door leaf width, read from the model's door parts."
    },
    {
      "id": "door_fixed_open_passing",
      "label": "Door fixed open passing",
      "face": "front",
      "min_m": 0.500,
      "source": "IEC 60364-7-729, Annex A, clause A.1",
      "value_source": "standard",
      "configurable": false,
      "reference": "door_edge_open_90",
      "door_state": "fixed_open",
      "obstacle": "any",
      "applies_if": { "area": "closed_restricted", "doors_lock_open": true },
      "level": "required",
      "note": "Passing room between the edge of a door fixed open and the opposite side of the gangway. Door edge position comes from the model's door geometry."
    },
    {
      "id": "end_wall_access",
      "label": "End wall access",
      "face": "side",
      "min_m": 0.700,
